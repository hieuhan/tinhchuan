TIMEZONE=Asia/Ho_Chi_Minh

# ---------- PostgreSQL Database ----------
DB_NAME=tinhchuan_prod
DB_USER=tinhchuan_app
DB_PASSWORD=ThayBang_openssl_rand_base64_32

# ---------- Mẫu kết nối DATABASE_URL cho Môi trường Phát triển (Dev) ----------
# 1. Trường hợp code TRỰC TIẾP trên máy Mac Mini M1 (chạy chung Postgres local):
#    DATABASE_URL=postgresql://tinhchuan_app:<password>@127.0.0.1:5432/tinhchuan_prod
#
# 2. Trường hợp code từ LAPTOP cá nhân, kết nối qua SSH Tunnel LocalForward:
#    (xem cấu hình Host tinhchuan-tunnel trong ~/.ssh/config, forward 127.0.0.1:5432 trên Mac Mini về 127.0.0.1:15432 trên laptop)
#    DATABASE_URL=postgresql://tinhchuan_app:<password>@127.0.0.1:15432/tinhchuan_prod
#
# LƯU Ý: Hai chuỗi mẫu trên CHỈ dùng để tham khảo qua comment. Giá trị DATABASE_URL thực tế
# được đặt trong file .env.development.local (không commit) trên từng máy tương ứng.
DATABASE_URL=postgresql://tinhchuan_app:ThayBang_openssl_rand_base64_32@127.0.0.1:5432/tinhchuan_prod

# ---------- Mật khẩu khởi tạo Admin ban đầu ----------
ADMIN_INITIAL_PASSWORD=ThayBang_mat_khau_that_manh

# ---------- Secret dịch vụ khác ----------
REDIS_PASSWORD=ThayBang_openssl_rand_base64_32
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=ThayBang_openssl_rand_base64_32
AUTH_SECRET=ThayBang_openssl_rand_base64_48
NEXT_PUBLIC_SITE_URL=https://tinhchuan.vn
NEXT_PUBLIC_CDN_URL=https://cdn.tinhchuan.vn
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...

# ---------- Google Analytics 4 ----------
# Measurement ID lấy từ Google Analytics 4 property (ví dụ: G-4D5BCPMG77).
# Đây không phải secret (sẽ lộ công khai trong HTML trang web), nhưng vẫn được quản lý
# qua biến môi trường để dễ bật/tắt theo môi trường (tắt ở dev, bật ở production).
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
